{
  "name": "marrquito-jampa-pulse",
  "main": ".output/server/index.mjs",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": ["**/*.mjs", "**/*.js"]
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".output/public"
  }
}
